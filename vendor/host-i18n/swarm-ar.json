    {"regex": "^over ([0-9a-zA-Z .<>]+)$", "replacement": "خلال $1"},
    {"regex": "^of (\\d+)$", "replacement": "/ $1"},
    {"regex": "^of (\\d+) · #(\\d+) at ([^()]+) \\(\\+([^)]+)\\)$", "replacement": "/ $1 · #$2 عند $3 (+$4)"},
    {"regex": "^read #(\\d+) · updated ([0-9a-zA-Z .<>]+ ago)$", "replacement": "قُرئ حتى #$1 · حُدّث $2"},
    {"regex": "^read #(\\d+)$", "replacement": "قُرئ حتى #$1"},
    {"regex": "^Narrator read up to #(\\d+) of (\\d+)$", "replacement": "قرأ الراوي حتى #$1 من أصل $2"},
    {"regex": "^(\\d+) posts? since the view was updated$", "replacement": "$1 منشور منذ آخر تحديث للعرض"},
    {"regex": "^overview · from the narrator['’]s notes · view\\.html is over 64 KB$", "replacement": "نظرة عامة · من ملاحظات الراوي · يتجاوز view.html حجم 64 كيلوبايت"},
    {"regex": "^overview · from the narrator['’]s notes · no view\\.html yet$", "replacement": "نظرة عامة · من ملاحظات الراوي · لا يوجد view.html بعد"},
    {"regex": "^overview · from the narrator['’]s notes · loading the narrator view$", "replacement": "نظرة عامة · من ملاحظات الراوي · جارٍ تحميل عرض الراوي"},
    {"regex": "^overview · from the narrator['’]s notes · the narrator['’]s view failed \\(([^)]+)\\)$", "replacement": "نظرة عامة · من ملاحظات الراوي · فشل تحميل عرض الراوي ($1)"},
    {"regex": "^([A-Za-z0-9_.-]+) \\(you\\)$", "replacement": "$1 (أنت)"},
    {"regex": "^Exporting (\\d+)%$", "replacement": "جارٍ التصدير $1%"},
    {"regex": "^(\\d+) frames? · ([0-9.]+ (?:B|KB|MB))$", "replacement": "$1 إطار · $2"},
    {"regex": "^Exported ([^\\n(]+) \\(([^)]+)\\)$", "replacement": "تم تصدير $1 ($2)"},
    {"regex": "^GIF ready \\(([^)]+)\\) — right-click image to save\\.$", "replacement": "صورة GIF جاهزة ($1) — انقر بزر الفأرة الأيمن للحفظ."},
    {"regex": "^Download ([^\\n]+)$", "replacement": "تنزيل $1"},
    {"regex": "^last seen (\\d+)m ago$", "replacement": "آخر ظهور منذ $1 دقيقة"},
    {"regex": "^last seen (\\d+)h ago$", "replacement": "آخر ظهور منذ $1 ساعة"},
    {"regex": "^last seen (\\d+)d ago$", "replacement": "آخر ظهور منذ $1 يوم"},
    {"regex": "^Now · (\\d+) / (\\d+)$", "replacement": "الآن · $1 / $2"},
    {"regex": "^Go to #(\\d+) on the Board$", "replacement": "الانتقال إلى #$1 في لوحة الرسائل"},
    {"regex": "^Posted in #([A-Za-z0-9_.-]+); click to show only #[A-Za-z0-9_.-]+$", "replacement": "نُشر في #$1؛ انقر لعرض #$1 فقط"},
    {"regex": "^Everyone in #([A-Za-z0-9_.-]+)$", "replacement": "الجميع في القناة #$1"},
    {"regex": "^#([A-Za-z0-9_.-]+) is archived: this addresses nobody$", "replacement": "القناة #$1 مؤرشفة: هذه الإشارة لا توجَّه لأحد"},
    {"regex": "^Runs on ([^\\n]+)$", "replacement": "يعمل على $1"},
    {"regex": "^Open @([A-Za-z0-9_.-]+)$", "replacement": "فتح @$1"},
    {"regex": "^Opening ([A-Za-z0-9_.-]+)'s conversation needs the app\\.$", "replacement": "يتطلب فتح محادثة $1 استخدام التطبيق."},
    {"regex": "^Remote · (\\d+) machines?$", "replacement": "عن بُعد · $1 جهاز"},
    {"regex": "^Remote · reconnecting$", "replacement": "عن بُعد · جارٍ إعادة الاتصال"},
